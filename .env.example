# Copia este archivo como .env (o exporta las variables en tu shell).
# Son los mismos valores que usa por defecto application.properties.

# 8082: el 8080/8081 los ocupan otros proyectos del portfolio.
SERVER_PORT=8082

# La MISMA base que escribe la app Android de RF Inventario.
DB_HOST=localhost
# 3306 = MySQL instalado en Windows
DB_PORT=3306
DB_NAME=rf_inventario
DB_USER=root
DB_PASSWORD=root123

# Origen del panel web.
CORS_ORIGINS=http://localhost:4200,http://localhost:5173,http://localhost:3000

# false apaga Swagger UI y /v3/api-docs.
SWAGGER_ENABLED=true

# Firma de los tokens (32+ caracteres). NO versionar en produccion.
JWT_SECRETO=rf-inventario-panel-secreto-de-desarrollo-cambialo-en-produccion
JWT_HORAS=12

# Operario sembrado si la tabla `users` esta vacia.
SEED_CODIGO=1001
SEED_PIN=1234
SEED_NOMBRE=Operario Demo

# Administrador del panel web sembrado si la tabla `panel_admins` esta vacia.
# El login del panel es aparte del de la app (ver migracion V5).
ADMIN_SEED_CODIGO=9001
ADMIN_SEED_PIN=4321
ADMIN_SEED_NOMBRE=Supervisor Demo
